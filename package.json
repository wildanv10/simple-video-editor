{
  "name": "video-trimmer",
  "version": "1.0.0",
  "description": "A simple video editor for trimming and joining clips, with a Clipchamp-style timeline.",
  "author": "wildanv10",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "build:web": "node scripts/build-web.js",
    "web": "node scripts/build-web.js && node scripts/serve.js dist-web 5180"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wildanv10.videotrimmer",
    "productName": "Video Trimmer",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "33.4.11",
    "files": [
      "main.js",
      "preload.js",
      "media.js",
      "exporter.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "export-plan.js",
      "web-api.js"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Video-Trimmer-Setup-${version}.exe"
    }
  }
}
