{
  "name": "simple-video-editor",
  "version": "1.0.0",
  "description": "A simple video editor for the desktop (Electron) and the browser (ffmpeg.wasm): trim, split and join clips on a multi-line timeline, lossless whenever possible.",
  "keywords": [
    "video",
    "editor",
    "trim",
    "ffmpeg",
    "ffmpeg.wasm",
    "electron"
  ],
  "author": "wildanv10",
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "start:web": "npm run build:web && node scripts/serve.js dist-web 5180",
    "build:web": "node scripts/build-web.js",
    "deploy:web": "npm run build:web && npx --yes wrangler@4 pages deploy dist-web --project-name simple-video-editor --commit-dirty=true",
    "build:desktop": "electron-builder --win nsis --x64",
    "build:icons": "node scripts/build-sprite.js",
    "check": "node scripts/check.js",
    "clean": "node scripts/clean.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wildanv10.simplevideoeditor",
    "productName": "Simple Video Editor",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "33.4.11",
    "files": [
      "main.js",
      "preload.js",
      "exporter.js",
      "export-plan.js",
      "media.js",
      "web-api.js",
      "index.html",
      "renderer.js",
      "styles.css"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Simple-Video-Editor-Setup-${version}.exe"
    }
  }
}
